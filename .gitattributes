# Finales de línea normalizados: LF en el repositorio, sea cual sea el sistema
# (evita diffs enteros al editar desde Windows y scripts rotos en Linux/macOS).
* text=auto eol=lf

# Scripts de Windows con CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios: nunca convertir
*.png binary
*.ico binary
*.icns binary
*.wav binary
*.mp3 binary
*.ogg binary
*.dmg binary
*.exe binary
